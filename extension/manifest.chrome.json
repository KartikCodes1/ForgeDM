{
  "manifest_version": 3,
  "name": "ForgeDM Integration",
  "short_name": "ForgeDM",
  "version": "1.0.0",
  "description": "Sends downloads, videos and links from your browser to the ForgeDM download manager app for faster, resumable downloads.",
  "homepage_url": "https://github.com/KartikCodes1/ForgeDM",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ForgeDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "110"
}
